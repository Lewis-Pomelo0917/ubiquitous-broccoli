{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cubic",
  "mainBinaryName": "Cubic",
  "version": "0.1.5-dev-0921",
  "identifier": "com.tradedesk.app",
  "build": {
    "frontendDist": "../../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cubic",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
